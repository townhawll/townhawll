# Local development only. Copy this file to .env before running infrastructure.
POSTGRES_DB=townhawll
POSTGRES_USER=townhawll
POSTGRES_PASSWORD=townhawll_dev
POSTGRES_PORT=5433

DATABASE_URL=postgresql://townhawll:townhawll_dev@localhost:5433/townhawll

# Redis is temporary infrastructure only. Permanent state belongs in PostgreSQL.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Generate a unique value for local development, for example with:
# openssl rand -base64 32
AUTH_SECRET=

# Google OAuth credentials. Configure this redirect URI in Google Cloud:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public origin used to create links in transactional email.
APP_URL=http://localhost:3000

# Transactional email. The resend.dev sender can deliver only to the email
# attached to your Resend account. Use your verified domain for other recipients.
RESEND_API_KEY=
EMAIL_FROM=TownHawll <onboarding@resend.dev>
