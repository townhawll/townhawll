{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "APP_URL",
    "AUTH_GOOGLE_ID",
    "AUTH_GOOGLE_SECRET",
    "AUTH_SECRET",
    "DATABASE_URL",
    "EMAIL_FROM",
    "LOG_LEVEL",
    "NODE_ENV",
    "OWNER_BOOTSTRAP_ENABLED",
    "REDIS_URL",
    "RESEND_API_KEY",
    "STORAGE_DRIVER",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET_NAME",
    "R2_PUBLIC_URL",
    "TMDB_ACCESS_TOKEN",
    "IGDB_CLIENT_ID",
    "IGDB_CLIENT_SECRET",
    "STEAM_API_KEY",
    "TOWNHAWLL_DB_INTEGRATION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "@townhawll/web#build": {
      "dependsOn": ["^build", "@townhawll/db#generate"],
      "env": ["NEXT_PUBLIC_SENTRY_DSN_WEB"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "@townhawll/admin#build": {
      "dependsOn": ["^build", "@townhawll/db#generate"],
      "env": ["NEXT_PUBLIC_SENTRY_DSN_ADMIN"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "generate": {
      "outputs": ["generated/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "@townhawll/integrations#test": {
      "dependsOn": ["^test"],
      "env": ["TOWNHAWLL_PROVIDER_SMOKE"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/db/prisma/*.prisma"],
      "outputs": []
    },
    "@townhawll/db#test": {
      "dependsOn": ["generate"],
      "cache": false,
      "outputs": []
    },
    "@townhawll/content#test": {
      "dependsOn": ["^test"],
      "cache": false,
      "outputs": []
    },
    "@townhawll/db#lint": {
      "dependsOn": ["^lint", "generate"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@townhawll/db#typecheck": {
      "dependsOn": ["^typecheck", "generate"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@townhawll/web#dev": {
      "cache": false,
      "env": ["NEXT_PUBLIC_SENTRY_DSN_WEB"],
      "persistent": true
    },
    "@townhawll/admin#dev": {
      "cache": false,
      "env": ["NEXT_PUBLIC_SENTRY_DSN_ADMIN"],
      "persistent": true
    }
  }
}
