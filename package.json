{
  "name": "townhawll",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down --volumes --remove-orphans",
    "db:generate": "pnpm --filter @townhawll/db generate",
    "db:migrate": "pnpm --filter @townhawll/db db:migrate",
    "db:reset": "pnpm --filter @townhawll/db db:reset",
    "db:studio": "pnpm --filter @townhawll/db db:studio",
    "db:smoke": "pnpm --filter @townhawll/db db:smoke"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.11.0"
  }
}
