{
  "name": "@townhawll/integrations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.ts",
    "./identity": "./src/identity.ts",
    "./catalogue-candidates": "./src/catalogue-candidates.ts",
    "./game-candidates": "./src/game-candidates.ts",
    "./game-supplements": "./src/game-supplements.ts",
    "./normalization": "./src/normalization/index.ts",
    "./selection": "./src/selection/index.ts",
    "./steam": {
      "browser": null,
      "default": "./src/providers/steam/index.ts"
    },
    "./igdb": {
      "browser": null,
      "default": "./src/providers/igdb/index.ts"
    },
    "./tmdb": {
      "browser": null,
      "default": "./src/providers/tmdb/index.ts"
    },
    "./http": {
      "browser": null,
      "default": "./src/http/index.ts"
    },
    "./config": {
      "browser": null,
      "default": "./src/config.ts"
    }
  },
  "dependencies": {
    "@townhawll/config": "workspace:*",
    "@townhawll/observability": "workspace:*",
    "htmlparser2": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@townhawll/eslint-config": "workspace:*",
    "@townhawll/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
